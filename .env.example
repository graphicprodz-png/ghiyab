# ===== إعدادات عامة =====
PORT=3000
TZ=Africa/Algiers
# مجلد قاعدة البيانات (اجعله على قرص دائم عند الاستضافة)
DATA_DIR=./data
# حساب المدير الأول (يُنشأ عند أول تشغيل فقط)
ADMIN_USER=admin
ADMIN_PASS=change-me-now
# ضع 1 إذا كان الموقع يعمل على https
COOKIE_SECURE=1

# ===== الإرسال الآلي =====
# manual            : بدون إرسال آلي (أزرار واتساب/SMS يدوية في الواجهة)
# http              : بوابة SMS عبر هاتف أندرويد بشريحة المؤسسة أو أي مزوّد له واجهة HTTP
# twilio_sms        : SMS عبر Twilio
# twilio_whatsapp   : واتساب عبر Twilio
# whatsapp_cloud    : واتساب عبر WhatsApp Cloud API من Meta
# يمكن وضع أكثر من مزوّد مفصولة بفاصلة، يُجرَّب الثاني إذا فشل الأول:
# NOTIFY_PROVIDER=whatsapp_cloud,http
NOTIFY_PROVIDER=manual

# --- http (بوابة SMS عامة) ---
HTTP_URL=
# مثال: Basic base64(user:pass)  أو  Bearer TOKEN
HTTP_AUTH=
# المتغيرات: {phone} = 213550123456   {phone_plus} = +213550123456   {message} = نص الرسالة
HTTP_BODY={"phoneNumbers":["{phone_plus}"],"message":"{message}"}

# --- Twilio ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=
WA_PHONE_ID=
# اسم قالب معتمد يحتوي متغيراً واحداً {{1}} يوضع فيه نص الإشعار
WA_TEMPLATE=
WA_TEMPLATE_LANG=ar
WA_API_VERSION=v21.0
